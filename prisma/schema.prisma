generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" /* cloud-compatible: works on Vercel + local (embedded pg) */
  url      = env("DATABASE_URL")
}

/* ── Admin auth ─────────────────────────────── */
model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/* ── Key/value settings (session secret etc.) ── */
model Setting {
  key   String @id
  value String
}

/* ── Selected Work projects ─────────────────── */
model Project {
  id               String   @id @default(cuid())
  projectNumber    String   @default("")
  name             String
  slug             String   @unique
  shortDescription String
  fullDescription  String   @default("")
  category         String   @default("")
  year             String   @default("")
  status           String   @default("LIVE") // LIVE | IN DEVELOPMENT | ARCHIVED
  technologies     String   @default("") // comma separated
  liveUrl          String   @default("")
  githubUrl        String   @default("")
  domain           String   @default("") // browser-frame URL label
  coverImage       String   @default("") // large screenshot path
  coverImageSm     String   @default("") // small screenshot path (optional)
  imageAlt         String   @default("")
  screenshots      String   @default("[]") // JSON array of extra image urls
  featured         Boolean  @default(false)
  published        Boolean  @default(true)
  displayOrder     Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

/* ── The Lab experiments ────────────────────── */
model LabExperiment {
  id           String   @id @default(cuid())
  experimentId String   @unique // LAB_001
  title        String
  description  String
  status       String   @default("CONCEPT") // CONCEPT | RESEARCH | EXPLORING | BUILDING | LIVE | ARCHIVED
  dateLabel    String   @default("") // SEP 2026
  tags         String   @default("") // comma separated
  url          String   @default("")
  githubUrl    String   @default("")
  coverVisual  String   @default("")
  techNotes    String   @default("") // hover-revealed note
  published    Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/* ── Testimonials / client notes ────────────── */
model Testimonial {
  id             String   @id @default(cuid())
  clientLabel    String // NONPROFIT CLIENT
  role           String   @default("") // Organization Website
  organization   String   @default("")
  quote          String
  avatar         String   @default("")
  relatedProject String   @default("")
  dateLabel      String   @default("") // CLIENT WORK · 2026
  status         String   @default("RECONSTRUCTED") // RECONSTRUCTED | VERIFIED
  published      Boolean  @default(true)
  displayOrder   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/* ── Editable profile / site content ────────── */
model Profile {
  id                 String   @id @default("main")
  displayName        String   @default("CIPHER")
  headline           String   @default("I build useful digital products with AI & the web.")
  heroDescription    String   @default("")
  availabilityStatus String   @default("AVAILABLE FOR WORK")
  location           String   @default("PAKISTAN")
  aboutText          String   @default("")
  aboutTextSecondary String   @default("")
  email              String   @default("")
  githubUrl          String   @default("")
  linkedinUrl        String   @default("")
  resumeUrl          String   @default("")
  contactCta         String   @default("Start a Conversation")
  skills             String   @default("[]") // JSON [{ label, items: [{ name, note }] }]
  updatedAt          DateTime @updatedAt
}

/* ── Media library ──────────────────────────── */
model MediaAsset {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  url          String   @unique // served via /api/media/[id] (DB-backed, Vercel-safe)
  mimeType     String
  size         Int
  width        Int      @default(0)
  height       Int      @default(0)
  data         String   @default("") @db.Text // base64 image bytes (cloud-safe storage)
  createdAt    DateTime @default(now())
}
